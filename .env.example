# Pipeline keys — copy to .env at the REPO ROOT (config.py loads REPO_ROOT/.env).
# Stage 1 (directory scrape) needs none of these. See RUNBOOK.md for the run flow.
#
# The WEB APP's variables (TITANS_DB_URL, ANTHROPIC_API_KEY for chat,
# CHAT_TOKEN_SECRET, UPSTASH_REDIS_REST_URL/_TOKEN, ...) live in web/.env.example.

# Anthropic Claude — REQUIRED. Haiku structuring / verification / reconciliation,
# Sonnet identity gate, phase3 --llm overlay, sector + seniority classifiers.
ANTHROPIC_API_KEY=

# Firecrawl — REQUIRED (the key), but ZERO CREDITS IS FINE. phase2_enrich.py
# needs the key to construct the client; the baseline path (PDL + Perplexity +
# Jina) spends no credits. Credits are used only by the gated deep path
# (career scrape, news, LinkedIn agent read) under --max-credits.
FIRECRAWL_API_KEY=

# People Data Labs — the résumé "spine" (person enrichment, ~$0.28 per match,
# misses are free; monthly quota on the free tier). Optional: unset → PDL step is
# skipped. --no-pdl hard-disables it for a run.
PDL_API_KEY=

# Perplexity — /search mention discovery (~$0.005/request) and Sonar press
# discovery, both Haiku identity-verified. Optional: unset → those passes skip.
# Key: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# GNews — LEGACY / experiment-only. Retired from enrichment (the Perplexity +
# Haiku verified-mention pass replaced it); read only by the frozen
# experiments/news_experiment.py. Leave unset.
GNEWS_API_KEY=
